# Copy to .env and fill in from the Firebase console:
#   Project settings -> General -> Your apps -> Web app -> SDK setup and configuration
#
# These values are NOT secret. They ship in the client bundle of every Firebase web
# app; Firestore is protected by firestore.rules, not by hiding this config. They
# live in env vars so another club can fork this repo and point it at their own
# project without editing source.
#
# In dev (`npm run dev:start`) the app always talks to the local emulator, so you
# can leave these blank while working offline.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Phase 2 — the Cloudflare Worker that proxies AI requests. Leave blank in v1;
# the AI assistant hides itself when this is not set. See worker/README.md.
VITE_AI_WORKER_URL=
