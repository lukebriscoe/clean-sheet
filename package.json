{
  "name": "clean-sheet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Training session planner for grassroots football coaches",
  "scripts": {
    "dev": "vite",
    "dev:start": "concurrently -n emulator,vite -c yellow,cyan \"firebase emulators:start --import=./emulator-data --export-on-exit=./emulator-data\" \"vite\"",
    "dev:seed": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8088 node scripts/seed-drills.js",
    "seed:prod": "node scripts/seed-drills.js --prod",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "node scripts/verify-e2e.mjs",
    "diagrams": "node scripts/add-seed-diagrams.mjs"
  },
  "dependencies": {
    "dompurify": "^3.2.3",
    "firebase": "^11.1.0",
    "marked": "^15.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "firebase-admin": "^13.0.2",
    "playwright": "^1.62.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
